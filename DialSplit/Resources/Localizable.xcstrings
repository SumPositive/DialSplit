          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez le package GoogleMobileAds pour activer la prise en charge des publicités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi il pacchetto GoogleMobileAds per abilitare il supporto pubblicitario."
