    "admob.packageMessage": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie das GoogleMobileAds-Paket hinzu, um die Werbeunterstützung zu aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the GoogleMobileAds package to enable ad support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el paquete GoogleMobileAds para habilitar el soporte de anuncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le package GoogleMobileAds pour activer la prise en charge des publicités."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GoogleMobileAds パッケージを追加すると広告応援機能が有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GoogleMobileAds 패키지를 추가하면 광고 응원 기능이 활성화됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入 GoogleMobileAds 套件即可啟用廣告支援功能。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il pacchetto GoogleMobileAds per abilitare il supporto pubblicitario."
          }
        }
      }
    },
