    "rate.this.app.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Teilen Sie uns gerne Ihre Wünsche und Vorschläge mit. Sie helfen uns bei der Auswahl künftiger Funktionen und Verbesserungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "We’d love to hear your requests and suggestions. They help us decide which new features and improvements to work on next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nos encantaría conocer tus peticiones y sugerencias. Nos ayudan a decidir qué funciones y mejoras desarrollar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "N’hésitez pas à nous faire part de vos demandes et suggestions. Elles nous aident à choisir les prochaines fonctionnalités et améliorations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faccelo sapere con richieste e suggerimenti. Ci aiutano a decidere quali nuove funzioni e miglioramenti realizzare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご要望やご提案もぜひお聞かせください。今後の新機能や改善を検討する際の参考にさせていただきます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "요청이나 제안도 꼭 들려주세요. 앞으로의 새 기능과 개선을 검토할 때 참고하겠습니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "也歡迎告訴我們您的需求與建議。這些意見將作為我們規劃新功能與改善的參考。"
          }
        }
      }
    },
