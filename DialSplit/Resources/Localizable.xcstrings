    "admob.packageMessage" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie das GoogleMobileAds-Paket hinzu, um die Werbeunterstützung zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the GoogleMobileAds package to enable ad support."
